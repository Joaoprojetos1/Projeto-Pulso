# =============================================================================
# Pulso — API. Variáveis de ambiente (exemplo). Copie para .env e preencha.
# NUNCA versione .env (já está no .gitignore). Aqui só vão PLACEHOLDERS.
# =============================================================================

# ---- Banco de dados --------------------------------------------------------
# Local (sem instalar nada): pnpm db sobe um Postgres em localhost:5433.
# Na nuvem, use a string do Neon (o SSL liga sozinho para host que não é local).
DATABASE_URL=postgres://pulso:pulso@localhost:5433/pulso

# ---- Servidor --------------------------------------------------------------
PORT=3000
# Endereço de escuta. Local: 127.0.0.1. Na nuvem (Render): 0.0.0.0
# HOST=127.0.0.1
# production liga o HSTS e o log em JSON. Deixe em branco no dev.
# NODE_ENV=production
# Nível do log estruturado: trace|debug|info|warn|error (padrão info)
# LOG_LEVEL=info

# ---- IA (Anthropic) — OPCIONAL --------------------------------------------
# Sem a chave, os alertas usam o texto padrão determinístico e a conversa
# responde o aviso honesto — tudo funciona.
# ANTHROPIC_API_KEY=sk-ant-...
# Modelo por superfície (opcionais): alerta usa o mais forte, conversa o mais barato.
# PULSO_ALERT_MODEL=claude-opus-4-8
# PULSO_CHAT_MODEL=claude-sonnet-4-6
# Memória da conversa (opcionais): nº de mensagens e teto de tokens do contexto.
# PULSO_CHAT_HISTORY_N=10
# PULSO_CHAT_TOKEN_BUDGET=6000

# ---- Segurança -------------------------------------------------------------
# Origens extras liberadas no CORS (o site e a demo web já entram por padrão),
# separadas por vírgula. Ex.: um domínio próprio no futuro.
# PULSO_CORS_ORIGINS=https://app.seudominio.com.br
# Limites de rate limit por minuto (opcionais; têm padrão no código).
# PULSO_RL_LOGIN=20
# PULSO_RL_SIGNUP=20
# PULSO_RL_FORGOT=20
# PULSO_RL_CHAT=30

# ---- Assinatura ------------------------------------------------------------
# Segredo do webhook do provedor de pagamento. Sem ele, o webhook recusa tudo.
# PULSO_WEBHOOK_SECRET=troque-por-um-segredo-forte

# ---- WhatsApp (canal da conversa) — OPCIONAL ------------------------------
# Sem estas variáveis, o canal WhatsApp fica DESLIGADO (o resto do produto não
# muda). Provedor de referência: WhatsApp Cloud API da Meta.
#   PULSO_WHATSAPP_PROVIDER: meta (padrão) | none
#   PHONE_ID e TOKEN: do app no Meta for Developers (WhatsApp Business).
#   VERIFY_TOKEN: um segredo que você escolhe e repete na config do webhook da Meta.
# Webhook a cadastrar na Meta: GET/POST  https://<sua-api>/webhooks/whatsapp
# PULSO_WHATSAPP_PROVIDER=meta
# PULSO_WHATSAPP_PHONE_ID=123456789012345
# PULSO_WHATSAPP_TOKEN=EAAG...
# PULSO_WHATSAPP_VERIFY_TOKEN=troque-por-um-segredo

# ---- E-mail (recuperação de senha) ----------------------------------------
# Com a chave da Resend + remetente, envia de verdade. Sem elas, cai no log de
# dev (que NÃO imprime o token, por LGPD; use PULSO_LOG_EMAILS=1 para depurar).
# PULSO_RESEND_API_KEY=re_...
# PULSO_EMAIL_FROM=Pulso <no-reply@seudominio.com.br>
# PULSO_LOG_EMAILS=1

# ---- Operação (admin) ------------------------------------------------------
# E-mails que viram admin ao entrar (separados por vírgula): CEO, especialista.
# PULSO_ADMIN_EMAILS=voce@exemplo.com,especialista@exemplo.com
